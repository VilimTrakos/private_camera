# Kucni Wi-Fi (samo 2,4 GHz). Kamera se spaja na njega, ali NEMA pristup
# internetu: ne uzima gateway ni DNS od routera, pa vidi samo lokalnu mrezu.
# Adresu kamere vidis u debug/localcam.log ili u popisu uredaja na routeru.
# Ako je HOME_SSID prazan, kamera radi svoju mrezu (AP, ispod).
HOME_SSID=
HOME_PASSWORD=

# Vlastita mreza kamere: koristi se kad HOME_SSID nije upisan ili se kamera ne
# uspije spojiti na kucni Wi-Fi. Kamera je tada na http://192.168.10.1/
# Lozinka: 8 do 63 znaka. Kanal: 1 do 11.
AP_SSID=Kamera
AP_PASSWORD=
AP_CHANNEL=6

# Lozinka za stranicu kamere (obavezna: dok je nema, stranica je zakljucana).
# Browser je pita jednom; korisnicko ime moze biti bilo sto. Do 63 znaka.
WEB_PASSWORD=

# FTP kamere (port 21, korisnik root, pristup cijelom sustavu). Radi samo uz
# hash lozinke, bez njega se gasi. Hash se radi u WSL-u: openssl passwd -1 'lozinka'
# (kamera zna samo MD5-crypt, $1$...; same lozinke nema na kartici).
FTP_PASSWORD_HASH=
