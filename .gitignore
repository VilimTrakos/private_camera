# Kopija flasha i raspakirani firmware: tuđi kod, ostaje samo lokalno
/dump/
/rootfs/

# Logovi s kamere sadrže Wi-Fi lozinku i Yi bindkey u čistom tekstu
*.log

# Ghidra projekt i cijeli dekompajlirani firmware ostaju lokalno; u repou
# su samo dijelovi koje localcam zamjenjuje (original/)
/*.gpr
/*.rep/
/*_decompiled/

# Izlaz build.sh i testova
/localcam/sd/debug/lib/
/localcam/test/build/

# Wi-Fi lozinke: na kartici je wifi.conf, u repou samo wifi.conf.example
/localcam/sd/debug/wifi.conf

# Postavke koje kamera sama piše na karticu (upload.conf sadrži FTP lozinku)
/localcam/sd/debug/camera.conf
/localcam/sd/debug/upload.conf
/localcam/sd/debug/upload.state
